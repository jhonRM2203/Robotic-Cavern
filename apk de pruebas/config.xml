<?xml version='1.0' encoding='utf-8'?>
<widget id="com.ingenierojhon.cavernbubble" version="1.0.4" xmlns="http://www.w3.org/ns/widgets"
    xmlns:cdv="http://cordova.apache.org/ns/1.0"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <name>robotic cavern</name>
    <content src="index.html" />
    <plugin name="cordova-plugin-whitelist" version="1" />
    <plugin name="gdevelop-cordova-plugin-screen-orientation" version="3.0.4-patch.2" />
    <access origin="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <allow-intent href="tel:*" />
    <allow-intent href="sms:*" />
    <allow-intent href="mailto:*" />
    <allow-intent href="geo:*" />

    <!-- Allow iframes on iOS like leaderboards, including those in development that are not served
    via https. -->
    <allow-navigation href="*" />

    <platform name="android">
        <allow-intent href="market:*" />

        <!-- Required by admob-plus plugin > version 2 -->
        <preference name="GradlePluginKotlinEnabled" value="true" />

        <!-- Increase timeout value for low-end android devices -->
        <preference name="loadUrlTimeoutValue" value="60000" />

        <icon src="www/Robot en la caverna neón.png" density="ldpi" />
<icon src="www/Robot en la caverna neón.png" density="mdpi" />
<icon src="www/Robot en la caverna neón.png" density="hdpi" />
<icon src="www/Robot en la caverna neón.png" density="xhdpi" />
<icon src="www/Robot en la caverna neón.png" density="xxhdpi" />
<icon src="www/Robot en la caverna neón.png" density="xxxhdpi" />
<preference name="AndroidWindowSplashScreenAnimatedIcon" value="www/Robot en la caverna neón.png" />

        <preference name="AndroidWindowSplashScreenBackground" value="#000000" />

        <!-- Required to get cordova-plugin-safariviewcontroller to call Chrome CustomTabs on
        Android. -->
        <config-file target="AndroidManifest.xml" parent="/manifest">
            <queries>
                <intent>
                    <action android:name="android.support.customtabs.action.CustomTabsService" />
                </intent>
            </queries>
        </config-file>
    </platform>
    <platform name="ios">
        <allow-intent href="itms:*" />
        <allow-intent href="itms-apps:*" />

        <preference name="SwiftVersion" value="5.3" />

        <!-- Apple requires a minimum OS version of 15.0 for App Store uploads
        (ITMS-90068, enforced from Spring 2027) and Xcode 27 refuses to build
        anything lower. -->
        <preference name="deployment-target" value="15.0" />

        <icon src="www/Robot en la caverna neón.png" width="180" height="180" />
<icon src="www/Robot en la caverna neón.png" width="152" height="152" />
<icon src="www/Robot en la caverna neón.png" width="167" height="167" />
<icon src="www/Robot en la caverna neón.png" width="167" height="167" />
<icon src="www/Robot en la caverna neón.png" width="1024" height="1024" />


        <edit-config file="*-Info.plist" mode="merge" target="UIRequiresFullScreen">
<true/>
</edit-config>
    </platform>

    <preference name="AndroidXEnabled" value="true" />

    <preference name="BackgroundColor" value="0xff000000" />

    <preference name="Orientation" value="landscape" />

    <!-- Android Fullscreen -->
    <preference name="Fullscreen" value="true" />

    <!-- Cordova/Phonegap version -->
    <preference name="phonegap-version" value="cli-9.0.0" />

    
</widget>